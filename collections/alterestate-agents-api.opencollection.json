{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlterEstate Agents API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.alterestate.com/api/v1/agents/",
            "auth": {
              "type": "apikey",
              "key": "aetoken",
              "value": "{{aetoken}}",
              "placement": "header"
            }
          },
          "docs": "Returns a JSON array containing all active agents in the company."
        }
      ]
    }
  ],
  "bundled": true
}